# =============================================================================
# DoughArt — public website (Next.js)
# Copy to frontend/.env.local — NEVER commit .env.local or real secrets
# Production guide: docs/PRODUCTION_LAUNCH.md
# =============================================================================

# --- Required ---
# Backend API URL (HTTPS in production), no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:5000
# PRODUCTION: NEXT_PUBLIC_API_URL=https://api.example.com

# Auth note: customer/admin auth cookies are configured for a 7-day max-age.
# Keep backend JWT_EXPIRES_IN aligned (current baseline: 7d) to avoid stale sessions.

# --- Required for production SEO / Open Graph ---
# Canonical public shop URL (HTTPS), no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PRODUCTION: NEXT_PUBLIC_SITE_URL=https://shop.example.com

# --- Payments ---
# Phase 1 policy: keep online payment disabled in production until gateway verification is complete.
# Must match backend ONLINE_PAYMENTS_ENABLED.
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false
# Bank transfer screenshot upload in checkout / My Order (enable for manual verification flow)
NEXT_PUBLIC_BANK_PROOF_UPLOAD_ENABLED=false

# --- Recommended ---
# WhatsApp digits with country code for wa.me links (03046736831 → 923046736831)
NEXT_PUBLIC_WHATSAPP=923046736831
# Backward-compatible alias supported by the frontend if NEXT_PUBLIC_WHATSAPP is unset
# NEXT_PUBLIC_WHATSAPP_NUMBER=923046736831
