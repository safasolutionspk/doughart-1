# =============================================================================
# DoughArt API â€” environment template
# Copy to backend/.env â€” NEVER commit .env or real secrets
# Production guide: docs/PRODUCTION_LAUNCH.md
# =============================================================================

# --- Required (all environments) ---
NODE_ENV=development
PORT=5000

# MongoDB â€” local dev OR Atlas in production (replace USER/PASSWORD/HOST)
MONGODB_URI=mongodb://127.0.0.1:27017/doughart
# PRODUCTION (Atlas):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/doughart?retryWrites=true&w=majority

# JWT â€” min 16 chars dev; 32+ cryptographically random chars in production
# Keep this aligned with admin/frontend auth cookie maxAge (currently 7 days).
# Example production value for current setup: JWT_EXPIRES_IN=7d
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Seed admin (npm run seed â€” first deploy only; change password after)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=DoughArt Admin

# CORS â€” comma-separated HTTPS origins, NO trailing slashes
# Must include BOTH public shop and admin dashboard URLs
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# PRODUCTION example:
# CORS_ORIGIN=https://shop.example.com,https://admin.example.com

# --- Recommended production (documentation / future emails) ---
# Public shop URL (HTTPS)
# FRONTEND_URL=https://shop.example.com
# Admin dashboard URL (HTTPS)
# ADMIN_URL=https://admin.example.com
# Password reset emails use FRONTEND_URL/reset-password?token=...
# Configure FRONTEND_URL + EMAIL_ENABLED/EMAIL_PROVIDER for real reset emails.

# --- Optional defaults ---
JSON_BODY_LIMIT=512kb
URLENCODED_BODY_LIMIT=512kb

# Uploads â€” see docs/UPLOADS.md
# local = backend/uploads/images/ (dev / VPS with persistent disk)
# cloudinary = optional production upgrade (recommended for multi-instance / serverless API)
UPLOAD_PROVIDER=local

# Cloudinary (required when UPLOAD_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=doughart

# --- Email â€” see backend/docs/EMAIL.md ---
EMAIL_ENABLED=true
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DoughArt Bakers <doughartbakers@gmail.com>"
ORDER_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
ADMIN_URL=http://localhost:3001
# FRONTEND_URL=http://localhost:3000

# Test without SMTP (logs previews to console):
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=console

# Production SMTP (Gmail example — use App Password, not account password):
# EMAIL_ENABLED=true
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=doughartbakers@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="DoughArt Bakers <doughartbakers@gmail.com>"
# ORDER_NOTIFICATION_EMAIL=doughartbakers@gmail.com
# CONTACT_NOTIFICATION_EMAIL=doughartbakers@gmail.com
# FRONTEND_URL=https://shop.example.com
# ADMIN_URL=https://admin.example.com

# Note: some hosting panels expose SMTP_PASS instead of SMTP_PASSWORD.
# The backend accepts either and normalizes SMTP_PASS -> SMTP_PASSWORD at startup.

# --- Customer orders (true in production by default) ---
# REQUIRE_CUSTOMER_AUTH_FOR_ORDERS=true
# Development: omit or set false to allow guest checkout against API

# --- Payments ---
# Customer checkout is Cash on Delivery only. New public orders are always
# created as cash_on_delivery; no env flag can enable another payment method.

# --- S3 upload (not implemented) ---
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
