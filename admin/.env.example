# --- Required ---
# Backend API URL (HTTPS in production), no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:5000
# PRODUCTION: NEXT_PUBLIC_API_URL=https://api.example.com

# Server-only â€” must match backend JWT_SECRET exactly
# Min 16 chars dev; 32+ random characters in production
JWT_SECRET=change-me-to-a-long-random-jwt-secret-at-least-32-characters

# Session: admin cookies use 7-day max-age (see lib/auth/constants.ts).
# Backend JWT_EXPIRES_IN should match cookie max-age (current baseline: 7d).
# /dashboard requires a valid sb_admin_token.
