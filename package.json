{
  "name": "sweetbite",
  "version": "1.0.0",
  "private": true,
  "description": "DoughArt — custom cake bakery monorepo (API, admin, website)",
  "scripts": {
    "build": "npm run build:backend && npm run build:admin && npm run build:frontend",
    "build:backend": "npm run build --prefix backend",
    "build:admin": "npm run build --prefix admin",
    "build:frontend": "npm run build --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:admin": "npm run dev --prefix admin",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "start:admin": "npm run start --prefix admin",
    "start:frontend": "npm run start --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "smoke": "npm run smoke --prefix backend",
    "smoke:frontend": "node scripts/smoke-frontend.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs",
    "verify:data-flow": "npm run verify:data-flow --prefix backend",
    "lint": "npm run lint --prefix admin && npm run lint --prefix frontend"
  }
}
