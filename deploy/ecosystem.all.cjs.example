/**
 * Example: all three apps on one VPS via PM2.
 * Copy to /opt/sweetbite/ecosystem.config.cjs and adjust paths/domains.
 *
 *   cp deploy/ecosystem.all.cjs.example /opt/sweetbite/ecosystem.config.cjs
 *   pm2 start /opt/sweetbite/ecosystem.config.cjs --env production
 */
const REPO = "/opt/sweetbite";

module.exports = {
  apps: [
    {
      name: "sweetbite-backend",
      cwd: `${REPO}/backend`,
      script: "dist/index.js",
      instances: 1,
      exec_mode: "fork",
      autorestart: true,
      max_restarts: 10,
      min_uptime: "10s",
      env_production: { NODE_ENV: "production" },
      error_file: `${REPO}/backend/logs/pm2-error.log`,
      out_file: `${REPO}/backend/logs/pm2-out.log`,
      merge_logs: true,
      time: true,
    },
    {
      name: "sweetbite-frontend",
      cwd: `${REPO}/frontend`,
      script: "node_modules/next/dist/bin/next",
      args: "start -p 3000",
      instances: 1,
      exec_mode: "fork",
      autorestart: true,
      max_restarts: 10,
      min_uptime: "10s",
      env_production: { NODE_ENV: "production", PORT: "3000" },
      error_file: `${REPO}/frontend/logs/pm2-error.log`,
      out_file: `${REPO}/frontend/logs/pm2-out.log`,
      merge_logs: true,
      time: true,
    },
    {
      name: "sweetbite-admin",
      cwd: `${REPO}/admin`,
      script: "node_modules/next/dist/bin/next",
      args: "start -p 3001",
      instances: 1,
      exec_mode: "fork",
      autorestart: true,
      max_restarts: 10,
      min_uptime: "10s",
      env_production: { NODE_ENV: "production", PORT: "3001" },
      error_file: `${REPO}/admin/logs/pm2-error.log`,
      out_file: `${REPO}/admin/logs/pm2-out.log`,
      merge_logs: true,
      time: true,
    },
  ],
};
